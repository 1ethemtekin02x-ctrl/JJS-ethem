local function MakeToggle(parent, text, initialOn, callback)
	local btn = Instance.new("TextButton")
	btn.Size = UDim2.new(1, 0, 0, 42)
	btn.BackgroundColor3 = initialOn and Color3.fromRGB(30, 155, 95) or Color3.fromRGB(36, 40, 52)
	btn.BorderSizePixel = 0
	btn.Text = text .. ": " .. (initialOn and "ON" or "OFF")
	btn.TextColor3 = Color3.new(1, 1, 1)
	btn.TextSize = 13
	btn.Font = Enum.Font.GothamBold
	btn.Parent = parent
	Instance.new("UICorner", btn).CornerRadius = UDim.new(0, 8)

	local state = initialOn
	btn.MouseButton1Click:Connect(function()
		state = not state
		btn.Text = text .. ": " .. (state and "ON" or "OFF")
		btn.BackgroundColor3 = state and Color3.fromRGB(30, 155, 95) or Color3.fromRGB(36, 40, 52)
		callback(state)
	end)
	return btn
end

local function MakeStep(parent, label, getVal, step, minV, maxV, onChange)
	local box = Instance.new("Frame")
	box.Size = UDim2.new(1, 0, 0, 42)
	box.BackgroundColor3 = Color3.fromRGB(30, 34, 45)
	box.BorderSizePixel = 0
	box.Parent = parent
	Instance.new("UICorner", box).CornerRadius = UDim.new(0, 8)

	local txt = Instance.new("TextLabel")
	txt.Size = UDim2.new(1, -96, 1, 0)
	txt.Position = UDim2.fromOffset(12, 0)
	txt.BackgroundTransparency = 1
	txt.Text = label .. ": " .. tostring(getVal())
	txt.TextColor3 = Color3.fromRGB(235, 238, 246)
	txt.TextSize = 12
	txt.Font = Enum.Font.GothamBold
	txt.TextXAlignment = Enum.TextXAlignment.Left
	txt.Parent = box

	local plus = Instance.new("TextButton")
	plus.Size = UDim2.fromOffset(38, 28)
	plus.Position = UDim2.new(1, -86, 0.5, -14)
	plus.BackgroundColor3 = Color3.fromRGB(45, 150, 95)
	plus.Text = "+"
	plus.TextColor3 = Color3.new(1, 1, 1)
	plus.TextSize = 15
	plus.Font = Enum.Font.GothamBlack
	plus.Parent = box
	Instance.new("UICorner", plus).CornerRadius = UDim.new(0, 6)

	local minus = Instance.new("TextButton")
	minus.Size = UDim2.fromOffset(38, 28)
	minus.Position = UDim2.new(1, -44, 0.5, -14)
	minus.BackgroundColor3 = Color3.fromRGB(175, 50, 65)
	minus.Text = "-"
	minus.TextColor3 = Color3.new(1, 1, 1)
	minus.TextSize = 15
	minus.Font = Enum.Font.GothamBlack
	minus.Parent = box
	Instance.new("UICorner", minus).CornerRadius = UDim.new(0, 6)

	plus.MouseButton1Click:Connect(function()
		local nv = math.clamp(getVal() + step, minV, maxV)
		onChange(nv)
		txt.Text = label .. ": " .. tostring(nv)
	end)

	minus.MouseButton1Click:Connect(function()
		local nv = math.clamp(getVal() - step, minV, maxV)
		onChange(nv)
		txt.Text = label .. ": " .. tostring(nv)
	end)
end


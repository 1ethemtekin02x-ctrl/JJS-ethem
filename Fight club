task.spawn(function()
	while task.wait(0.09) do
		local char, hrp = GetChar()
		if char and hrp then
			local _, _, eHRP, dist = GetNearestEnemy(Config.AutoChase and 160 or 18)

			if Config.AutoChase and eHRP and dist > 3.0 then
				local behindPos = eHRP.Position - (eHRP.CFrame.LookVector * 3.2)
				pcall(function()
					char:PivotTo(CFrame.new(behindPos, eHRP.Position))
					hrp.AssemblyLinearVelocity = Vector3.zero
				end)
			end

			if Config.AutoBlock and eHRP and dist < 11 then
				DoBlock()
			end

			if Config.AutoPunch or Config.AutoComboKick then
				if eHRP and dist < 14 then
					pcall(function()
						Camera.CFrame = CFrame.new(Camera.CFrame.Position, eHRP.Position + Vector3.new(0, 1.1, 0))
					end)
				end
				if Config.AutoComboKick then
					DoKickCombo()
				elseif Config.AutoPunch then
					DoPunch()
				end
			end
		end
	end
end)

task.spawn(function()
	while task.wait(0.30) do
		if Config.PlayerESP then
			pcall(UpdateESP)
		elseif next(State.ESPObjects) ~= nil then
			pcall(ClearESP)
		end
	end
end)


local function GetChar()
	local char = LocalPlayer.Character
	if not char then return nil, nil, nil end
	local hrp = char:FindFirstChild("HumanoidRootPart") or char:FindFirstChild("Torso")
	local hum = char:FindFirstChildOfClass("Humanoid")
	return char, hrp, hum
end

local function ApplyImage(imgObject, assetIdStr)
	if not imgObject then return end
	local cleanId = tostring(assetIdStr or MASK_ASSET_ID):gsub("%D", "")
	if cleanId == "" then cleanId = MASK_ASSET_ID end
	local primary = "rbxassetid://" .. cleanId
	imgObject.Image = primary
	task.spawn(function()
		pcall(function()
			ContentProvider:PreloadAsync({imgObject})
		end)
		task.wait(0.8)
		if imgObject.IsLoaded == false then
			imgObject.Image = "rbxthumb://type=Asset&id=" .. cleanId .. "&w=420&h=420"
		end
	end)
end

local function GetNearestEnemy(maxDist)
	local char, hrp = GetChar()
	if not char or not hrp then return nil, nil, nil, math.huge end

	local bestPlr, bestChar, bestHRP = nil, nil, nil
	local bestDist = maxDist or 140

	for _, plr in ipairs(Players:GetPlayers()) do
		if plr ~= LocalPlayer and plr.Character then
			local eChar = plr.Character
			local eHRP = eChar:FindFirstChild("HumanoidRootPart")
			local eHum = eChar:FindFirstChildOfClass("Humanoid")
			if eHRP and eHum and eHum.Health > 0 then
				local d = (eHRP.Position - hrp.Position).Magnitude
				if d < bestDist then
					bestDist = d
					bestPlr = plr
					bestChar = eChar
					bestHRP = eHRP
				end
			end
		end
	end

	return bestPlr, bestChar, bestHRP, bestDist
end

local function FireGuiByKeywords(keywords)
	local hitAny = false
	for _, gui in ipairs(PlayerGui:GetDescendants()) do
		if gui:IsA("GuiButton") and gui.Visible and gui.AbsoluteSize.Magnitude > 4 then
			if not gui:IsDescendantOf(PlayerGui:FindFirstChild("BLACKHAT_FC_UI") or Instance.new("Folder")) then
				local txt = string.lower(gui.Name .. " " .. (gui:IsA("TextButton") and gui.Text or ""))
				for _, kw in ipairs(keywords) do
					if string.find(txt, kw, 1, true) then
						pcall(function()
							if firesignal then
								firesignal(gui.MouseButton1Down)
								firesignal(gui.MouseButton1Click)
								firesignal(gui.Activated)
								firesignal(gui.MouseButton1Up)
							end
						end)
						hitAny = true
					end
				end
			end
		end
	end
	return hitAny
end

local function SendMobileTap(x, y)
	local vp = Camera.ViewportSize
	local px = x or (vp.X * 0.75)
	local py = y or (vp.Y * 0.65)

	if VirtualInputManager then
		pcall(function()
			VirtualInputManager:SendMouseButtonEvent(px, py, 0, true, game, 1)
			task.wait(0.02)
			VirtualInputManager:SendMouseButtonEvent(px, py, 0, false, game, 1)
		end)
	end

	pcall(function()
		VirtualUser:CaptureController()
		VirtualUser:Button1Down(Vector2.new(px, py), Camera.CFrame)
		task.wait(0.02)
		VirtualUser:Button1Up(Vector2.new(px, py), Camera.CFrame)
	end)
end

local function DoPunch()
	local now = os.clock()
	if now - State.LastPunch < 0.11 then return end
	State.LastPunch = now

	local char = LocalPlayer.Character
	if char then
		for _, item in ipairs(char:GetChildren()) do
			if item:IsA("Tool") then
				pcall(function() item:Activate() end)
			end
		end
	end

	FireGuiByKeywords({"punch", "fist", "jab", "cross", "hook", "hit", "attack", "strike"})
	SendMobileTap(Camera.ViewportSize.X * 0.72, Camera.ViewportSize.Y * 0.62)
end

local function DoKickCombo()
	local now = os.clock()
	if now - State.LastKick < 0.16 then return end
	State.LastKick = now

	State.PunchToggle = not State.PunchToggle
	if State.PunchToggle then
		FireGuiByKeywords({"high", "kick", "roundhouse", "uppercut", "heavy", "special", "combo"})
	else
		FireGuiByKeywords({"low", "kick", "leg", "sweep", "punch", "hit"})
	end
	DoPunch()
end

local function DoBlock()
	local now = os.clock()
	if now - State.LastBlock < 0.22 then return end
	State.LastBlock = now
	FireGuiByKeywords({"block", "guard", "parry", "defend"})
end

